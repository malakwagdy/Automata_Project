<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Polygon?>

<VBox fx:id="inputField" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automata_project.PDAPageController">
   <children>
      <TextField fx:id="inputTextField" alignment="CENTER" onAction="#onCheckInput" promptText="Enter a string of a's and b's">
         <VBox.margin>
            <Insets left="20.0" right="20.0" />
         </VBox.margin>
      </TextField>
      <Label fx:id="inputLabel" />
      <Pane maxHeight="45.0" maxWidth="40.0" minHeight="45.0" minWidth="40.0" prefHeight="45.0" prefWidth="40.0">
         <children>
            <Line endX="20.0" endY="10.0" startX="20.0" startY="40.0" stroke="BLACK" strokeWidth="2.0" />
            <Polygon fill="BLACK" points="20.0,4.0,14.0,14.0,26.0,14.0" />
         </children>
      </Pane>
      <HBox alignment="CENTER" maxHeight="120.0" maxWidth="120.0" minHeight="120.0" minWidth="120.0" prefHeight="120.0" prefWidth="120.0" style="-fx-background-color: #d3d3d3; -fx-border-color: black; -fx-border-width: 2px;">
         <children>
            <Label fx:id="PDALabel" style="-fx-font-size: 22px; -fx-text-fill: black;" text="p" />
         </children>
      </HBox>
      <Pane maxHeight="45.0" maxWidth="40.0" minHeight="45.0" minWidth="40.0" prefHeight="45.0" prefWidth="40.0">
         <children>
            <Line endX="20.0" endY="35.0" startX="20.0" startY="5.0" stroke="BLACK" strokeWidth="2.0" />
            <Polygon fill="BLACK" points="20.0,41.0,14.0,31.0,26.0,31.0" />
         </children>
      </Pane>
      <Label fx:id="stackLabel" />
      <Label fx:id="statusLabel">
         <VBox.margin>
            <Insets bottom="10.0" top="10.0" />
         </VBox.margin></Label>
      <Button mnemonicParsing="false" onAction="#onBackClick" text="Back" />
   </children>
</VBox>
