<VBox alignment="CENTER" prefHeight="236.0" prefWidth="192.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automata_project.MainPageController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Main Menu">
      <font>
         <Font name="System Bold" size="14.0" />
      </font></Label>
    <Button onAction="#onCFGtoPDAClick" text="CFG to PDA" />
   <Button mnemonicParsing="false" onAction="#onDFAClick" text="DFA" />
   <Button mnemonicParsing="false" onAction="#onPDAClick" text="PDA" />
</VBox>
